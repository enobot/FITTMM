# Used by `npm start`. Points sign-in at the local Firebase Auth emulator
# (`firebase emulators:start --only auth` from the repo root), so no real
# Firebase project or keys are needed for development. "demo-" projects only
# exist in the emulator.
REACT_APP_FIREBASE_API_KEY=demo-api-key
REACT_APP_FIREBASE_AUTH_DOMAIN=demo-fittmm.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=demo-fittmm
REACT_APP_FIREBASE_APP_ID=demo-app
REACT_APP_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
