# Copy to .env.production.local (or set these in your hosting provider) for a
# real deployment. Values come from Firebase console > Project settings >
# Your apps > Web app. These are public identifiers, not secrets.
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your-project
REACT_APP_FIREBASE_APP_ID=

# Where the FastAPI backend is deployed (no trailing slash)
REACT_APP_API_URL=https://api.example.com

# Leave empty in production. Set to 127.0.0.1:9099 only for the local emulator.
REACT_APP_FIREBASE_AUTH_EMULATOR_HOST=
