# Copy to backend/.env for local development, or set these as environment
# variables on your host. Never commit the real .env.

# MySQL / MariaDB
DATABASE_URL=mysql+mysqlconnector://fitness_user:CHANGE_ME@localhost/fitness_app

# Signs legacy /auth/login tokens. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME

# Firebase project that the web and Android apps sign in with
FIREBASE_PROJECT_ID=demo-fittmm
# Local development only: accept tokens from the Firebase Auth emulator.
# Remove this line in production.
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Browser origins allowed to call the API (comma-separated). Production example:
# CORS_ORIGINS=https://fittmm.web.app,https://fittmm.example.com
CORS_ORIGINS=

# Optional: YouTube Data API v3 key for tutorial video picks
# (Google Cloud console > APIs & Services > enable "YouTube Data API v3" > Credentials)
YOUTUBE_API_KEY=

# Production settings
# ENABLE_LEGACY_PASSWORD_AUTH=false
# SEED_DEMO_USER=false
